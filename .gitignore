# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
.env/

# ── Secrets & config ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Distribution / packaging ──────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
site/
wheels/

# ── Testing & coverage ────────────────────────────────────────────────────────
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.tox/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Prism: runtime data (session DBs, logs, user uploads) ────────────────────
logs/
retrieval/user_dbs/
user_input/

# ── Prism: built corpus indexes (regenerated by ingest) ──────────────────────
retrieval/corpus/*.pageindex.json

# ── Prism: sandbox / scratch ──────────────────────────────────────────────────
sandbox/
debug_run.py

# ── Claude Code internals ────────────────────────────────────────────────────
.agents/
skills-lock.json

# ── Next.js ───────────────────────────────────────────────────────────────────
web/.next/
web/node_modules/
web/.env.local
web/.env.production

